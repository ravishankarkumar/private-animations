{
  "name": "private-animations",
  "version": "1.0.0",
  "description": "private animations using Veena",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:veena": "npm --prefix ../../veena run build",
    "render:agent": "npm run build:veena && tsx mute-animations/agent.ts",
    "render:llm": "npm run build:veena && tsx mute-animations/llm-next-token.ts",
    "render:embedding": "npm run build:veena && tsx mute-animations/word-embedding-map.ts",
    "render:trig": "npm run build:veena && tsx mute-animations/trig-three-graphs.ts",
    "render:fractal:koch": "npm run build:veena && tsx fractal-shorts/koch-snowflake.ts",
    "render:fractal:sierpinski": "npm run build:veena && tsx fractal-shorts/sierpinski-triangle.ts",
    "render:fractal:tree": "npm run build:veena && tsx fractal-shorts/recursive-tree.ts",
    "render:fractal:mandelbrot": "npm run build:veena && tsx fractal-shorts/mandelbrot.ts",
    "render:fractal:mandelbrot-core": "npm run build:veena && tsx fractal-shorts/mandelbrot-core.ts",
    "render:fractal:mandelbrot-core-grok": "npm run build:veena && tsx fractal-shorts/mandelbrot-core-grok.ts",
    "render:fractal:sine-ring": "npm run build:veena && tsx fractal-shorts/sine-ring.ts",
    "render:fractal:mandelbulb": "npm run build:veena && tsx fractal-shorts/mandelbulb.ts",
    "render:fractal:pi-arms": "npm run build:veena && tsx fractal-shorts/pi-arms.ts",
    "render:fractal:neural-network": "npm run build:veena && tsx fractal-shorts/neural-network.ts",
    "render:logo:visionforbharat": "npm run build:veena && tsx logos/visionforbharat.ts",
    "render:fractals": "npm run build:veena && tsx fractal-shorts/koch-snowflake.ts && tsx fractal-shorts/sierpinski-triangle.ts && tsx fractal-shorts/recursive-tree.ts && tsx fractal-shorts/mandelbrot.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "veena": "file:../../veena",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
